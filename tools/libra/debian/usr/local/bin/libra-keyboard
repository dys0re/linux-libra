#!/bin/sh
# Onboard's own D-Bus API reliably toggles its dock without losing focus.
if [ "${XDG_SESSION_TYPE:-}" = wayland ]; then
 exec pkill -RTMIN -u "$(id -u)" -x wvkbd-mobintl
fi
exec dbus-send --session --print-reply --type=method_call --dest=org.onboard.Onboard \
 /org/onboard/Onboard/Keyboard org.onboard.Onboard.Keyboard.ToggleVisible
