#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Run inside the user's existing Xfce session, including an upgraded userdata.
set -eu
marker="$HOME/.config/libra/battery-initialized"
panel_marker="$HOME/.config/libra/battery-panel-v2"
reload_panel=${LIBRA_PANEL_RELOAD:-0}
if [ ! -e "$marker" ]; then
 setprop() {
  xfconf-query -c xfce4-power-manager -p "/xfce4-power-manager/$1" -n -t "$2" -s "$3"
 }
 setprop dpms-enabled bool false
 setprop inactivity-on-ac uint 0
 setprop inactivity-on-battery uint 0
 # Xfce uses 9 seconds as the "never dim" sentinel.
 setprop brightness-on-ac uint 9
 setprop brightness-on-battery uint 9
 setprop power-button-action uint 0
 setprop sleep-button-action uint 0
 setprop hibernate-button-action uint 0
 setprop lid-action-on-ac uint 0
 setprop lid-action-on-battery uint 0
 setprop critical-power-action uint 0
 setprop critical-power-level uint 10
 setprop lock-screen-suspend-hibernate bool false
 setprop show-tray-icon bool false
 mkdir -p "${marker%/*}"
 touch "$marker"
fi
if [ ! -e "$panel_marker" ] || [ "$reload_panel" = 1 ]; then
 xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/show-panel-label -n -t int -s 1
 # Check the active panel, rather than unused plugin definitions from old layouts.
 ids=$(xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids | awk '/^[0-9]+$/{print}')
 battery_plugin=0
 for id in $ids; do
  if [ "$(xfconf-query -c xfce4-panel -p "/plugins/plugin-$id")" = power-manager-plugin ]; then
   battery_plugin=1
  fi
 done
 if [ "$battery_plugin" = 0 ]; then
  plugin=8
  while xfconf-query -c xfce4-panel -p "/plugins/plugin-$plugin" >/dev/null 2>&1; do
   plugin=$((plugin + 1))
  done
  xfconf-query -c xfce4-panel -p "/plugins/plugin-$plugin" -n -t string -s power-manager-plugin
  set --
  for id in $ids "$plugin"; do set -- "$@" -t int -s "$id"; done
  xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids -n -a "$@"
 fi
 reload_panel=1
fi
rm -f "$HOME/.config/autostart/xfce4-power-manager.desktop"
if ! pgrep -u "$(id -u)" -f '^(/usr/bin/)?xfce4-power-manager([[:space:]]|$)' >/dev/null; then
 mkdir -p "$HOME/.cache"
 xfce4-power-manager > "$HOME/.cache/libra-power-manager.log" 2>&1 &
fi
if [ "$reload_panel" = 1 ]; then
 mkdir -p "$HOME/.cache"
 xfce4-panel --restart > "$HOME/.cache/libra-battery-panel.log" 2>&1
 # Mark completion only after the configured plugin has been loaded.
 touch "$panel_marker"
fi
