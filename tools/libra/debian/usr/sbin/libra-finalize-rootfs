#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
DEBIAN_FRONTEND=noninteractive apt-get install -y evtest libinput-tools \
 libglib2.0-bin libnotify-bin dbus-x11 procps at-spi2-core gir1.2-atspi-2.0
chmod 755 /usr/sbin/libra-usb-gadget /usr/local/bin/libra-memory-check \
 /usr/sbin/libra-finalize-rootfs /usr/sbin/libra-radio-status /usr/sbin/libra-radio-start /usr/sbin/libra-bluetooth-address /usr/local/bin/libra-desktop-setup \
 /usr/local/bin/libra-keyboard /usr/local/bin/libra-maximize-windows \
 /usr/local/bin/libra-desktop-action /usr/local/bin/libra-brightness
systemctl enable libra-radio.service libra-usb.service libra-usb-dhcp.service libra-drm.service \
 libra-ssh-keys.service serial-getty@ttyGS0.service
mkdir -p /etc/libra
printf 'Debian trixie arm64; Xfce X11; software OpenGL; userdata F2FS\n' > /etc/libra/image-release
cat > /etc/resolv.conf <<'EOF'
nameserver 223.5.5.5
nameserver 1.1.1.1
EOF
mkdir -p /home/libra/.config/autostart /home/libra/.config/fcitx5 \
 /home/libra/.local/share/applications /home/libra/Desktop
panel_dir=/home/libra/.config/xfce4/xfconf/xfce-perchannel-xml
mkdir -p "$panel_dir"
if [ ! -e "$panel_dir/xfce4-panel.xml" ]; then
 cp /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml "$panel_dir/"
fi
cp /etc/skel/.xsessionrc /home/libra/.xsessionrc
cp /etc/skel/.config/autostart/libra-desktop.desktop /home/libra/.config/autostart/
cat > /home/libra/.config/fcitx5/profile <<'EOF'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=pinyin

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=pinyin
Layout=

[GroupOrder]
0=Default
EOF
cat > /home/libra/.xinputrc <<'EOF'
run_im fcitx5
EOF
cat > /home/libra/.config/autostart/xfce4-power-manager.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Power manager
Hidden=true
EOF
cat > /home/libra/.config/autostart/onboard-autostart.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Onboard
Hidden=true
EOF
cp /usr/share/applications/libra-keyboard.desktop /home/libra/Desktop/
cp /usr/share/applications/libra-terminal.desktop /home/libra/Desktop/
chmod 755 /home/libra/Desktop/*.desktop
chown -R libra:libra /home/libra
# Brightness changes are the only passwordless privileged desktop action.
cat > /etc/sudoers.d/libra-brightness <<'EOF'
libra ALL=(root) NOPASSWD: /usr/local/bin/libra-brightness
EOF
chmod 440 /etc/sudoers.d/libra-brightness
visudo -cf /etc/sudoers.d/libra-brightness
systemd-analyze verify /etc/systemd/system/libra-*.service
dnsmasq --test --conf-file=/etc/libra-usb-dhcp.conf
