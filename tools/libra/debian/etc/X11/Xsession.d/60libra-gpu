# Xfce remains an X11 session. Select the paired private Mesa libraries.
if [ -f /etc/libra/gpu-desktop ] && [ "$(cat /etc/libra/gpu-desktop)" = 1 ]; then
    unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER QT_QUICK_BACKEND
    export LD_LIBRARY_PATH=/usr/lib/libra-gpu/dri
    export LIBGL_DRIVERS_PATH=/usr/lib/libra-gpu/dri
    export GBM_BACKENDS_PATH=/usr/lib/libra-gpu/dri
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/lib/libra-gpu/egl-vendor.json
fi
